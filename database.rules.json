{
  "rules": {
    ".read": false,
    ".write": false,
    "system": {
      "bootstrap": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'OWNER' && data.exists()",
        ".write": "false"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'OWNER' && root.child('users').child(auth.uid).child('businessId').val() == data.child('businessId').val())",
        ".write": "auth != null && auth.uid == $uid && (!data.exists() || newData.child('ownerUid').val() == auth.uid) && (!data.exists() || newData.child('role').val() == data.child('role').val())",
        "ownerUid": {
          ".validate": "newData.val() == auth.uid || (data.exists() && newData.val() == data.val())"
        },
        "role": {
          ".validate": "!data.exists() ? newData.val() == 'OWNER' : newData.val() == data.val()"
        }
      }
    },
    "businesses": {
      "$businessId": {
        ".read": "auth != null && data.child('ownerUid').val() == auth.uid",
        ".write": "auth != null && ((data.exists() && data.child('ownerUid').val() == auth.uid) || (!data.exists() && newData.child('ownerUid').val() == auth.uid))"
      }
    },
    "outlets": {
      "$outletId": {
        ".read": "auth != null && (data.child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)",
        ".write": "auth != null && ((data.exists() && data.child('ownerUid').val() == auth.uid) || (!data.exists() && newData.child('ownerUid').val() == auth.uid))",
        "workers": {
          "$uid": {
            ".read": "auth != null && (root.child('users').child(auth.uid).child('outletId').val() == $outletId || root.child('users').child(auth.uid).child('role').val() == 'OWNER' && data.parent().parent().child('ownerUid').val() == auth.uid)",
            ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'OWNER' && root.child('users').child(auth.uid).child('businessId').val() == data.parent().parent().child('businessId').val()"
          }
        },
        "products": {
          "$id": {
            ".read": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)",
            ".write": "auth != null && root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid",
            "stock": {
              ".write": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)"
            }
          }
        },
        "categories": {
          "$id": {
            ".read": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)",
            ".write": "auth != null && root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid"
          }
        },
        "transactions": {
          "$id": {
            ".read": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)",
            ".write": "auth != null && newData.child('outletId').val() == $outletId && newData.child('ownerUid').val() == root.child('outlets').child($outletId).child('ownerUid').val() && ((newData.child('cashierUid').val() == auth.uid && root.child('users').child(auth.uid).child('outletId').val() == $outletId) || root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid)"
          }
        },
        "shifts": {
          "$id": {
            ".read": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)",
            ".write": "auth != null && newData.child('outletId').val() == $outletId && (newData.child('cashierUid').val() == auth.uid || root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid)"
          }
        },
        "expenses": {
          "$id": {
            ".read": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)",
            ".write": "auth != null && (root.child('outlets').child($outletId).child('ownerUid').val() == auth.uid || root.child('users').child(auth.uid).child('outletId').val() == $outletId)"
          }
        }
      },
      ".read": "auth != null && query.orderByChild == 'ownerUid' && query.equalTo == auth.uid",
      ".indexOn": [
        "ownerUid"
      ]
    }
  }
}